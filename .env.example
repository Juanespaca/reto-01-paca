# Copia este archivo a .env y completa tu propia clave. Nunca commitees .env.

# Proveedor usado por src/llm/anthropic.ts
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Puerto del servidor (opcional)
PORT=3000

# Tope de tokens por sesión, para que nadie agote la clave sin límite (opcional)
TOPE_TOKENS_SESION=200000
