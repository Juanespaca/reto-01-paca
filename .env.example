# Copia este archivo a .env y completa tu propia clave. Nunca commitees .env.

# Proveedor usado por src/llm/anthropic.ts
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Puerto del servidor (opcional)
PORT=3000

# Tope de tokens por sesión, para que nadie agote la clave sin límite (opcional)
TOPE_TOKENS_SESION=200000

# Tope de iteraciones herramienta → modelo por turno (opcional, default 25)
TOPE_ITERACIONES=25

# Timeout de cada llamada al modelo en milisegundos (opcional, default 60000)
LLM_TIMEOUT_MS=60000

# Fecha AAAA-MM-DD para evaluar vigencias de soportes (opcional, default: hoy)
# FECHA_REFERENCIA=2026-09-15
